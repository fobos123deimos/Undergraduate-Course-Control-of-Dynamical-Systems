  "illustrations": [
    {
      "id": "physical-01",
      "source": "laboratories/01-thermal-enclosure/figures/physical-system.tikz",
      "preview": "laboratories/01-thermal-enclosure/figures/physical-system.png",
      "caption": "Cutaway of a lumped thermal enclosure. Orange arrows carry heat; the probe measures a lagged temperature. The drawing fixes the energy boundary, not a real device geometry."
    },
    {
      "id": "physical-02",
      "source": "laboratories/02-ventilation/figures/physical-system.tikz",
      "preview": "laboratories/02-ventilation/figures/physical-system.png",
      "caption": "A ventilated room and a well-mixed liquid analogue share an inventory balance. The room uses m$^3$ and the liquid case uses L; do not mix their concentration or flow units. Equal inlet and outlet volume flows keep each inventory constant."
    },
    {
      "id": "physical-03",
      "source": "laboratories/03-vibration-isolation/figures/physical-system.tikz",
      "preview": "laboratories/03-vibration-isolation/figures/physical-system.png",
      "caption": "An optical payload rests on parallel spring and damping elements. Both the floor and payload move; spring extension and damping velocity are relative quantities. Weight is balanced at the static equilibrium about which the model is written."
    },
    {
      "id": "physical-04",
      "source": "laboratories/04-notch-filter/figures/physical-system.tikz",
      "preview": "laboratories/04-notch-filter/figures/physical-system.png",
      "caption": "A source excites the series RLC network; an ideal differential probe spans the combined inductor and capacitor. Measuring only the capacitor would produce a different transfer function. Wire placement is schematic."
    },
    {
      "id": "physical-05",
      "source": "laboratories/05-motor-load-rejection/figures/physical-system.tikz",
      "preview": "laboratories/05-motor-load-rejection/figures/physical-system.png",
      "caption": "A voltage-driven motor converts armature current into shaft torque. The rotor and external brake introduce inertia, friction and load torque. The illustrative cutaway does not add magnetic saturation or friction to the stated linear model."
    },
    {
      "id": "physical-06",
      "source": "laboratories/06-root-locus/figures/physical-system.tikz",
      "preview": "laboratories/06-root-locus/figures/physical-system.png",
      "caption": "A motorized positioning axis illustrates the role of the integrator and two stable lags. The normalized transfer function is specified as a teaching model; the pictured dimensions do not identify its coefficients."
    },
    {
      "id": "physical-07",
      "source": "laboratories/07-delay-budget/figures/physical-system.tikz",
      "preview": "laboratories/07-delay-budget/figures/physical-system.png",
      "caption": "A remote mechanism sends measurements and receives commands through a communication path. The model combines those latencies into one ideal constant delay; the drawn packet train is not an experimental record."
    },
    {
      "id": "physical-08",
      "source": "laboratories/08-camera-compensation/figures/physical-system.tikz",
      "preview": "laboratories/08-camera-compensation/figures/physical-system.png",
      "caption": "A camera gimbal illustrates angular tracking and disturbance rejection. Its normalized plant is stipulated, with no claim that geometry alone determines its two poles."
    },
    {
      "id": "physical-09",
      "source": "laboratories/09-pid-saturation/figures/physical-system.tikz",
      "preview": "laboratories/09-pid-saturation/figures/physical-system.png",
      "caption": "A mass, spring, damper and bounded force actuator physically realize the normalized second-order plant. Force saturation is included; contact, dry friction and travel stops are not."
    },
    {
      "id": "physical-10",
      "source": "laboratories/10-observer-control/figures/physical-system.tikz",
      "preview": "laboratories/10-observer-control/figures/physical-system.png",
      "caption": "Two thermal inventories are connected by a conductive bridge. Heating acts in the first zone and sensing in the second. These stated capacities and conductances reproduce the two-state model exactly under the lumped assumptions."
    },
    {
      "id": "physical-11",
      "source": "laboratories/11-digital-control/figures/physical-system.tikz",
      "preview": "laboratories/11-digital-control/figures/physical-system.png",
      "caption": "A held voltage drives an ideal RC network. The capacitor voltage is sampled by an ideal ADC; the software controller updates the DAC once per period. Quantization, converter lag and electrical loading are omitted."
    },
    {
      "id": "physical-12",
      "source": "laboratories/12-identification-capstone/figures/physical-system.tikz",
      "preview": "laboratories/12-identification-capstone/figures/physical-system.png",
      "caption": "A stirred thermal inventory followed by ideal transport is one possible physical interpretation of the identified transfer function. Its fitted gain and time constant do not separately determine capacity, conductance and heater efficiency."
    },
    {
      "id": "physical-13",
      "source": "problem-sets/integrated-design/figures/interacting-tanks.tikz",
      "preview": "problem-sets/integrated-design/figures/interacting-tanks.png",
      "caption": "Interacting tanks share a submerged connection at a common datum. Flow reverses if the level ordering reverses. Only tank 2 drains to the exterior; this is not a cascade with a freely falling inter-tank stream."
    }
  ],
