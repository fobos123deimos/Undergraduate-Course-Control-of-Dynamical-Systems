\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
lab/.style={align=center,font=\sffamily\small,fill=white,fill opacity=.94,text opacity=1,rounded corners=2pt,inner sep=3.5pt},
lead/.style={draw=ink!70,line width=.7pt},
flow/.style={->,draw=blue!65!black,line width=1.15pt},
heat/.style={->,draw=orange!85!black,line width=1.15pt},
heatboth/.style={<->,draw=orange!85!black,line width=1.15pt},
measure/.style={->,draw=teal!70!black,line width=1.05pt},
digital/.style={->,draw=teal!70!black,line width=1pt,dashed},
beam/.style={->,draw=red!70!black,line width=.65pt},
dim/.style={<->,draw=ink!70,line width=.7pt},
wire/.style={draw=ink,line width=1pt}]
\IfFileExists{figures/hero-art.png}{\def\equipmentart{figures/hero-art.png}}{\IfFileExists{../../docs/images/hero-art.png}{\def\equipmentart{../../docs/images/hero-art.png}}{\IfFileExists{../docs/images/hero-art.png}{\def\equipmentart{../docs/images/hero-art.png}}{\def\equipmentart{docs/images/hero-art.png}}}}
\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=10.6667cm]{\equipmentart}};

% Aligned upper captions leave the tank walls and free surfaces unobstructed.
\node[lab,text=ink,text width=2.7cm] (pump) at (1.85,9.55) {Pump inflow $q$};
\draw[lead] (pump.south east)--(4.6,8.3);
\fill[ink] (4.6,8.3) circle (.028);
\node[lab,text=ink,text width=2.8cm] at (5.55,9.55) {Tank 1\\$A_1=0.02$ m$^2$};
\node[lab,text=ink,text width=2.8cm] at (10.55,9.55) {Tank 2\\$A_2=0.03$ m$^2$};
\node[lab,text=teal!70!black,text width=2.6cm] (sensor) at (14.15,9.55) {Level sensor\\$y=h_2$};
\draw[lead,draw=teal!70!black] (sensor.south west)--(13.3,8.1);
\fill[teal!70!black] (13.3,8.1) circle (.028);
% Captions below the apparatus keep the coupling, valve handles and drain visible.
\node[lab,text=ink,text width=3.6cm] (coupling) at (8,1.55) {Connection $q_{12}$\\bidirectional};
\draw[lead] (coupling.north)--(8,3.55)--(7.9,4.05);
\fill[ink] (7.9,4.05) circle (.028);
\node[lab,text=ink,text width=2.6cm] (drain) at (14.15,1.55) {Drain $q_2$};
\draw[lead] (drain.north)--(14.45,3.9);
\fill[ink] (14.45,3.9) circle (.028);
% Heads are referred to the common hydraulic outlet level, not the steel base.
\draw[dim,draw=teal!65!black] (3.05,4.05)--(3.05,6.75);
\draw[ink!50,line width=.6pt] (2.97,4.05)--(3.28,4.05) (2.97,6.75)--(3.35,6.75);
\node[lab,text=teal!70!black,text width=.48cm,inner sep=2pt] at (2.68,5.4) {$h_1$};
\draw[dim,draw=teal!65!black] (8.8,4.05)--(8.8,5.6);
\draw[ink!50,line width=.6pt] (8.72,4.05)--(9.02,4.05) (8.72,5.6)--(9.02,5.6);
\node[lab,text=teal!70!black,text width=.48cm,inner sep=2pt] at (8.4,5.3) {$h_2$};

