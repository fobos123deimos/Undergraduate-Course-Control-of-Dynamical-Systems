\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
lab/.style={align=center,font=\sffamily\small,fill=white,fill opacity=.94,text opacity=1,rounded corners=2pt,inner xsep=3pt,inner ysep=2.5pt},
lead/.style={draw=ink!80,line width=.65pt},
flow/.style={->,draw=blue!65!black,line width=1.15pt},
heat/.style={->,draw=orange!85!black,line width=1.15pt},
heatboth/.style={<->,draw=orange!85!black,line width=1.15pt},
measure/.style={->,draw=teal!70!black,line width=1.05pt},
digital/.style={->,draw=teal!70!black,line width=1pt,dashed},
beam/.style={->,draw=red!70!black,line width=.65pt},
dim/.style={<->,>={Latex[length=2mm,width=1.35mm]},draw=teal!65!black,line width=.7pt,
  preaction={draw=white,line width=1.6pt,opacity=.7}},
tick/.style={draw=ink!55,line width=.55pt,preaction={draw=white,line width=1.5pt,opacity=.7}},
wire/.style={draw=ink,line width=1pt}]
\IfFileExists{figures/hero-art.png}{\def\equipmentart{figures/hero-art.png}}{\IfFileExists{../../docs/images/hero-art.png}{\def\equipmentart{../../docs/images/hero-art.png}}{\IfFileExists{../docs/images/hero-art.png}{\def\equipmentart{../docs/images/hero-art.png}}{\def\equipmentart{docs/images/hero-art.png}}}}
\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=10.6667cm]{\equipmentart}};

% Aligned upper captions leave the tank walls and free surfaces unobstructed.
\node[lab,text=ink] (pump) at (1.85,9.55) {Pump inflow $q$};
\draw[lead,shorten <=3pt] (pump.south east)--(2.75,8.9);
\fill[ink] (2.75,8.9) circle (.025);
\node[lab,text=ink] at (5.55,9.55) {Tank 1\\$A_1=0.02$ m$^2$};
\node[lab,text=ink] at (10.55,9.55) {Tank 2\\$A_2=0.03$ m$^2$};
\node[lab,text=teal!70!black] (sensor) at (14.15,9.55) {Level sensor\\$y=h_2$};
\draw[lead,draw=teal!70!black,shorten <=3pt] (sensor.south west)--(13.3,8.1);
\fill[teal!70!black] (13.3,8.1) circle (.025);
% Captions below the apparatus keep the coupling, valve handles and drain visible.
\node[lab,text=ink] (coupling) at (8,1.3) {Connection $q_{12}$\\bidirectional};
\draw[lead,shorten <=3pt] (coupling.north)--(7.9,4.05);
\fill[ink] (7.9,4.05) circle (.025);
\node[lab,text=ink] (drain) at (14.15,1.3) {Drain $q_2$};
\draw[lead,shorten <=3pt] (drain.north)--(14.45,3.9);
\fill[ink] (14.45,3.9) circle (.025);
% Local outlet axes are projections of one hydraulic datum in the photograph.
% Keep dimension heads clear of the pump fittings, valve handles and pipework.
\draw[dim,shorten <=2pt,shorten >=2pt] (3.25,4.05)--(3.25,6.75);
\draw[tick] (3.13,4.05)--(3.39,4.05) (3.13,6.75)--(3.46,6.75);
\node[lab,text=teal!70!black] at (2.89,5.4) {$h_1$};
\draw[dim,shorten <=5pt,shorten >=2pt] (13.85,3.9)--(13.85,5.54);
\draw[tick] (13.73,3.9)--(13.98,3.9) (13.73,5.54)--(13.98,5.54);
\node[lab,text=teal!70!black] at (14.25,5.1) {$h_2$};

\end{tikzpicture}
