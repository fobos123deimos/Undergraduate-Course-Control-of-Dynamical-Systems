% Style 2: raster equipment illustration with exact editable TikZ annotations.
\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
lab/.style={align=center,font=\sffamily\small,fill=white,fill opacity=.94,text opacity=1,rounded corners=2pt,inner sep=3.5pt},
lead/.style={draw=ink!70,line width=.7pt},
flow/.style={->,draw=blue!65!black,line width=1.15pt},
heat/.style={->,draw=orange!85!black,line width=1.15pt},
heatboth/.style={<->,draw=orange!85!black,line width=1.15pt},
measure/.style={->,draw=teal!70!black,line width=1.05pt},
digital/.style={->,draw=teal!70!black,line width=1pt,dashed},
beam/.style={->,draw=red!70!black,line width=.65pt},
dim/.style={<->,draw=ink!70,line width=.7pt},
wire/.style={draw=ink,line width=1pt}]
\IfFileExists{figures/interacting-tanks-art.png}{\def\equipmentart{figures/interacting-tanks-art.png}}{\IfFileExists{../../problem-sets/integrated-design/figures/interacting-tanks-art.png}{\def\equipmentart{../../problem-sets/integrated-design/figures/interacting-tanks-art.png}}{\IfFileExists{../problem-sets/integrated-design/figures/interacting-tanks-art.png}{\def\equipmentart{../problem-sets/integrated-design/figures/interacting-tanks-art.png}}{\def\equipmentart{problem-sets/integrated-design/figures/interacting-tanks-art.png}}}}
\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=9cm]{\equipmentart}};
\node[anchor=west,text=ink,font=\sffamily\bfseries\large] at (.2,9.38) {Interacting water tanks};
\draw[lead,draw=blue!65!black] (3.1,8.25)--(3.3,7.25);
\fill[blue!65!black] (3.3,7.25) circle (.035);
\node[lab,text=blue!65!black,text width=3.5cm] at (3.1,8.25) {Pump inflow $q$};
\node[lab,text=ink,text width=3.3cm] at (5.0,4.2) {Tank 1\\$A_1=0.02$ m$^2$};
\node[lab,text=ink,text width=3.3cm] at (10.7,3.3) {Tank 2\\$A_2=0.03$ m$^2$};
\node[lab,text=ink,text width=5cm] at (10.4,8.1) {Shared atmosphere $p_a$};
\draw[dim] (3.0,2.65)--(3.0,5.5);
\node[lab,text=ink,text width=1.0cm] at (2.65,4.6) {$h_1$};
\draw[dim] (14.0,2.65)--(14.0,4.45);
\node[lab,text=ink,text width=1.0cm] at (14.55,4.0) {$h_2$};
\draw[lead,draw=ink] (7.85,5.6)--(7.8,3.0);
\fill[ink] (7.8,3.0) circle (.035);
\node[lab,text=ink,text width=3.6cm] at (7.85,5.6) {Connection $q_{12}$\\bidirectional};
\draw[flow] (6.95,3.0)--(8.7,3.0);
\draw[flow] (14.1,2.85)--(15.25,2.85);
\node[lab,text=ink,text width=2.5cm] at (14.6,1.75) {Drain $q_2$};
\draw[lead,draw=teal!70!black] (14.3,6.4)--(12.9,5.6);
\fill[teal!70!black] (12.9,5.6) circle (.035);
\node[lab,text=teal!70!black,text width=2.5cm] at (14.3,6.4) {$y=h_2$};
\draw[ink!50,dashed] (2.8,2.6)--(14.1,2.6);
\node[lab,text=ink,text width=13cm] at (8,0.55) {Common height datum; only tank 2 drains to the exterior};

\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(0.2,-.3){\textbf{Two volume inventories}\\[3pt]$A_1\dot h_1=q-q_{12}$.\\$A_2\dot h_2=q_{12}-q_2$.\\Only tank 2 drains to the exterior.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(5.55,-.3){\textbf{Gravity-driven coupling}\\[3pt]$q_{12}=k_{12}\operatorname{sgn}(h_1-h_2)$\\$\qquad\cdot\sqrt{|h_1-h_2|}$.\\$q_2=k_2\sqrt{h_2}$.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(10.9,-.3){\textbf{Interpret the arrows}\\[3pt]Displayed levels give forward connection flow; reversal is allowed. The open rims share atmospheric pressure and one elevation datum.};
\end{tikzpicture}
