% Style 2: raster equipment illustration with exact editable TikZ annotations.
\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
lab/.style={align=center,font=\sffamily\small,fill=white,fill opacity=.94,text opacity=1,rounded corners=2pt,inner xsep=3pt,inner ysep=2.5pt},
lead/.style={draw=ink!70,line width=.7pt},
flow/.style={->,draw=blue!65!black,line width=1.15pt},
heat/.style={-{Latex[length=2.2mm,width=1.5mm]},draw=orange!85!black,line width=1.05pt},
heatboth/.style={{Latex[length=2.2mm,width=1.5mm]}-{Latex[length=2.2mm,width=1.5mm]},draw=orange!85!black,line width=1.05pt},
measure/.style={-{Latex[length=2.2mm,width=1.5mm]},draw=teal!70!black,line width=1.05pt},
digital/.style={->,draw=teal!70!black,line width=1pt,dashed},
beam/.style={->,draw=red!70!black,line width=.65pt},
dim/.style={<->,draw=ink!70,line width=.7pt},
wire/.style={draw=ink,line width=1pt}]
\IfFileExists{figures/08-camera-compensation-art.png}{\def\equipmentart{figures/08-camera-compensation-art.png}}{\IfFileExists{../../laboratories/08-camera-compensation/figures/08-camera-compensation-art.png}{\def\equipmentart{../../laboratories/08-camera-compensation/figures/08-camera-compensation-art.png}}{\IfFileExists{../laboratories/08-camera-compensation/figures/08-camera-compensation-art.png}{\def\equipmentart{../laboratories/08-camera-compensation/figures/08-camera-compensation-art.png}}{\def\equipmentart{laboratories/08-camera-compensation/figures/08-camera-compensation-art.png}}}}
\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=9cm]{\equipmentart}};
\node[anchor=west,text=ink,font=\sffamily\bfseries\large] at (.2,9.38) {Camera-axis compensation};
% Leaders begin at label borders and terminate at the identified hardware.
\node[lab,text=ink] (cameraLabel) at (7.1,8.3) {Gimbal-mounted camera};
\draw[lead,draw=ink,shorten <=3pt] (cameraLabel.south)--(7.1,6.75);
\fill[ink] (7.1,6.75) circle (.035);
\node[lab,text=ink] (targetLabel) at (14.2,8.6) {Target};
\draw[lead,draw=ink,shorten <=3pt] (targetLabel.south)--(14.2,7.65);
\fill[ink] (14.2,7.65) circle (.035);
\node[lab,text=teal!70!black] (encoderLabel) at (1.8,2.65) {Angular encoder};
\draw[lead,draw=teal!70!black,shorten <=3pt] (encoderLabel.east)--(3.5,2.65)--(4.4,4.4);
\fill[teal!70!black] (4.4,4.4) circle (.035);
\coordinate (pivot) at (5.28,4.73);\fill[ink] (pivot)circle(.055);
% Fine construction extensions cross the equipment; the readable angle stays outside.
% These are mechanical orientation rays, not an optical beam from the pivot.
\draw[ink!45,dashed,line width=.55pt] (pivot)--(9.75,4.73);
\draw[teal!55!black,dashed,line width=.55pt] (pivot)--(9.75,5.68);
\draw[ink!65,dashed,line width=.8pt] (9.75,4.73)--(11.2,4.73);
\draw[teal!70!black,line width=1pt] (9.75,5.68)--(11.2,5.988);
\draw[{Latex[length=1.6mm,width=1.1mm]}-{Latex[length=1.6mm,width=1.1mm]},draw=ink!70,line width=.7pt]
  ($(pivot)+(0:5.1)$) arc[start angle=0,end angle=12,radius=5.1];
\node[lab,text=ink] at (11.25,5.3) {$\theta$};
% A concentric torque arc clears both the camera casing and the encoder.
\draw[heat] ($(pivot)+(140:2.15)$) arc[start angle=140,end angle=205,radius=2.15];
\node[lab,text=orange!85!black] at (1.85,6.5) {Torque $u$};
\node[lab,text=ink] at (8,0.35) {Normalized model $G(s)=1/[s(s+1)]$; geometry is illustrative};

\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(0.2,-.3){\textbf{Coordinate and actuation}\\[3pt]Positive angle is measured from the dashed reference ray. Torque acts about the marked gimbal pivot.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(5.55,-.3){\textbf{Normalized axis}\\[3pt]$G(s)=\dfrac{1}{s(s+1)}$.\\Lead supplies phase; lag changes low-frequency gain and the ramp error.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(10.9,-.3){\textbf{Limits of the view}\\[3pt]Encoder and lens establish the signal meaning. Camera inertia, gearing and dimensions do not identify this stipulated plant.};
\end{tikzpicture}
