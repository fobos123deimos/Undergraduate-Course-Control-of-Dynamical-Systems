\begin{tikzpicture}[x=1cm,y=1cm,>=Latex,font=\small,
block/.style={draw=ink,fill=blue!4,rounded corners=2pt,minimum height=9mm,align=center,line width=.7pt,inner sep=5pt},
sum/.style={circle,draw=ink,fill=white,minimum size=6mm,inner sep=0pt,line width=.7pt},
sig/.style={->,draw=ink,line width=.85pt},
fb/.style={->,draw=teal!70!black,line width=.85pt},
dist/.style={->,draw=orange!75!black,line width=.85pt},
tap/.style={circle,fill=ink,inner sep=1.4pt},
note/.style={font=\footnotesize,align=center,text=black!75}]

\node[sum](e)at(.9,1.5){$\Sigma$};
\node[block](lead)at(4,1.5){Lead\\$K\dfrac{Ts+1}{\alpha Ts+1}$};
\node[block](lag)at(8,1.5){Lag and normalization\\$g\dfrac{1+s/0.03}{1+s/0.006}$};
\node[block](plant)at(12,1.5){$\dfrac{1}{s(s+1)}$};
\draw[sig](-.2,1.5)--node[above]{$r$}node[pos=.9,below]{$+$}(e);
\draw[sig](e)--node[above]{$e$}(lead);\draw[sig](lead)--(lag);\draw[sig](lag)--(plant);
\draw[sig](plant)--(14.8,1.5)node[right]{$y$};
\draw[fb](14.3,1.5)--(14.3,-.1)--(.9,-.1)--node[pos=.9,left]{$-$}(e);
\fill[ink](14.3,1.5)circle(1.4pt);
\draw[sig](1,-2.1)--(14.5,-2.1)node[right]{$\omega$};
\foreach \x/\lab in {2/0.006,4/0.03,7/{1/T},10/{\omega_c=3},13/{1/(\alpha T)}}{\draw[ink](\x,-2)--(\x,-2.2);\node[below=2mm]at(\x,-2.1){$\lab$};}
\node[note]at(3,-1.35){lag pole and zero};
\node[note]at(7,-1.35){lead zero};\node[note]at(13,-1.35){lead pole};
\node[note]at(8,-3.2){Frequency order is schematic, not a logarithmic scale.\\The lag adds a small phase cost at the retained crossover.};

\end{tikzpicture}
