\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=9cm]{\equipmentart}};
\node[anchor=west,text=ink,font=\sffamily\bfseries\large] at (.2,9.38) {Identification of a process with transport delay};
\node[lab,text=ink] (inletLabel) at (2.5,8.25) {Inlet at ambient $T_a$\\constant flow $q$};
\draw[lead,shorten <=3pt] (inletLabel.south)--(2.3,7.0);
\fill[ink!70] (2.3,7.0) circle (.028);
% Transparent flow paths retain compact arrows on their centreline.
\draw[flow] (.65,7.0)--(1.7,7.0);
\node[lab,text=ink] (stirrerLabel) at (6.15,8.25) {Stirrer};
\draw[lead,shorten <=3pt] (stirrerLabel.south west)--(4.7,7.1);
\fill[ink!70] (4.7,7.1) circle (.028);
\node[lab,text=ink] (fluidLabel) at (10.0,8.25) {Well-mixed fluid\\state $x=T-T_a$};
\draw[lead,shorten <=3pt,rounded corners=2pt] (fluidLabel.south west)--(7.8,5.15)--(6.3,4.3);
\fill[ink!70] (6.3,4.3) circle (.028);
\node[lab,text=detailHeat] (heaterLabel) at (4.2,0.65) {Heater input $u$};
\draw[lead,draw=detailHeat,shorten <=3pt] (heaterLabel.north)--(4.2,2.5);
\fill[detailHeat] (4.2,2.5) circle (.028);
\draw[heat] (1.85,5.15)--(.55,5.8);
\node[lab,text=detailHeat] at (.85,4.8) {Heat\\loss};
\node[lab,text=ink] (delayLabel) at (10.05,4.85) {Transport delay $\theta$\\ideal plug flow};
\draw[lead,shorten <=3pt] (delayLabel.south east)--(10.7,3.0);
\fill[ink!70] (10.7,3.0) circle (.028);
\node[lab,text=teal!70!black] (sensorLabel) at (13.7,5.15) {Remote readout $y$};
\draw[lead,draw=teal!70!black,shorten <=3pt] (sensorLabel.south)--(13.6,3.85);
\fill[teal!70!black] (13.6,3.85) circle (.028);
\draw[flow] (7.9,3.35)--(9.4,3.35);
\draw[flow] (11.4,2.2)--(12.6,2.2);
\draw[flow] (15.08,2.2)--(15.7,2.2);
\node[lab,text=ink] at (14.65,1.5) {Outlet $q$};
\node[lab,text=ink] at (11.8,0.65) {$y(t)=x(t-\theta)$};

\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(0.2,-.3){\textbf{Synthetic experiment}\\[3pt]$G(s)=1.8e^{-0.6s}/(4s+1)$.\\Declared gain, lag and delay generate the records; none is a physical measurement.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(5.55,-.3){\textbf{Thermal interpretation}\\[3pt]One mixed energy store plus ideal transport. Through-flow and wall losses enter one effective conductance.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(10.9,-.3){\textbf{Identification boundary}\\[3pt]Fit on training data, freeze the model, then check a separate multistep record. Geometry does not identify capacity or heater efficiency.};
\end{tikzpicture}
