\draw[lead,draw=ink] (10.4,6.3)--(10.7,2.3);
\fill[ink] (10.7,2.3) circle (.035);
\node[lab,text=ink,text width=4.4cm] at (10.4,6.3) {Transport delay $\theta$\\ideal plug flow};
\draw[lead,draw=teal!70!black] (13.7,5.1)--(13.6,3.85);
\fill[teal!70!black] (13.6,3.85) circle (.035);
\node[lab,text=teal!70!black,text width=3.5cm] at (13.7,5.1) {Remote readout $y$};
