\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=9cm]{\equipmentart}};
\node[anchor=west,text=ink,font=\sffamily\bfseries\large] at (.2,9.38) {Identification of a process with transport delay};
\draw[lead,draw=ink] (2.0,8.1)--(2.3,7.0);
\fill[ink] (2.3,7.0) circle (.035);
\node[lab,text=ink,text width=4.0cm] at (2.0,8.1) {Matched inlet at ambient temperature};
\draw[lead,draw=ink] (6.2,8.2)--(4.7,7.1);
\fill[ink] (4.7,7.1) circle (.035);
\node[lab,text=ink,text width=2.2cm] at (6.2,8.2) {Stirrer};
\node[lab,text=ink,text width=3.5cm] at (4.65,4.3) {Mixed inventory\\temperature deviation $x$};
\draw[lead,draw=orange!85!black] (4.2,0.65)--(4.2,2.5);
\fill[orange!85!black] (4.2,2.5) circle (.035);
\node[lab,text=orange!85!black,text width=3.5cm] at (4.2,0.65) {Heater input $u$};
\draw[heat] (2.1,5.6)--(.5,6.2);
