\begin{tikzpicture}[x=1cm,y=1cm,>=Latex,font=\small,
block/.style={draw=ink,fill=blue!4,rounded corners=2pt,minimum height=9mm,align=center,line width=.7pt,inner sep=5pt},
sum/.style={circle,draw=ink,fill=white,minimum size=6mm,inner sep=0pt,line width=.7pt},
sig/.style={->,draw=ink,line width=.85pt},
fb/.style={->,draw=teal!70!black,line width=.85pt},
dist/.style={->,draw=orange!75!black,line width=.85pt},
tap/.style={circle,fill=ink,inner sep=1.4pt},
note/.style={font=\footnotesize,align=center,text=black!75}]

\node[sum](e)at(.9,0){$\Sigma$};
\node[block,minimum height=14mm](pi)at(4,0){$u_{PI}=k_pe+I$\\$\dot I=k_ie+v_{aw}$};
\node[sum](tot)at(7.2,0){$\Sigma$};
\node[block](sat)at(9.2,0){$\operatorname{clip}$\\$[-2,2]$};
\node[block](plant)at(12,0){$\dfrac{1}{s^2+2s+1}$};
\draw[sig](-.2,0)--node[above]{$r$}node[pos=.9,below]{$+$}(e);
\draw[sig](e)--node[above]{$e$}(pi);
\draw[sig](pi)--node[pos=.9,below]{$+$}(tot);
\draw[sig](tot)--node[above]{$u_*$}(sat);
\draw[sig](sat)--node[above]{$u$}(plant);
\draw[sig](plant)--(14.8,0)node[right]{$y$};
\node[block](df)at(10.2,2){$\dfrac{k_ds}{\tau_fs+1}$};
\draw[fb](14.1,0)--(14.1,2)--(df);
\draw[fb](df)--(7.2,2)--node[pos=.9,left]{$-$}(tot);
\fill[ink](14.1,0)circle(1.4pt);
\node[note]at(10.2,3){Derivative acts on measurement};
\node[sum](aw)at(9.2,-1.7){$\Sigma$};
\draw[dist](10.4,0)--(10.4,-1.7)--node[pos=.85,below]{$+$}(aw);
\draw[dist](8,0)--(8,-1.7)--node[pos=.85,below]{$-$}(aw);
\fill[ink](10.4,0)circle(1.4pt);\fill[ink](8,0)circle(1.4pt);
\node[block](kaw)at(6.5,-2.8){$k_{aw}$};
\draw[dist](aw)--(9.2,-2.8)--node[below]{$u-u_*$}(kaw);
\draw[dist](kaw)--(4,-2.8)--node[right]{$v_{aw}$}(pi.south);
\draw[fb](14.5,0)--(14.5,-4)--(.9,-4)--node[pos=.95,left]{$-$}(e);
\fill[ink](14.5,0)circle(1.4pt);
\node[note,fill=white]at(10.3,-4){Output feedback};

\end{tikzpicture}
