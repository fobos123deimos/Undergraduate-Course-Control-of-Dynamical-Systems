\begin{tikzpicture}[x=1cm,y=1cm,>=Latex,font=\small,
block/.style={draw=ink,fill=blue!4,rounded corners=2pt,minimum height=9mm,align=center,line width=.7pt,inner sep=5pt},
sum/.style={circle,draw=ink,fill=white,minimum size=6mm,inner sep=0pt,line width=.7pt},
sig/.style={->,draw=ink,line width=.85pt},
fb/.style={->,draw=teal!70!black,line width=.85pt},
dist/.style={->,draw=orange!75!black,line width=.85pt},
tap/.style={circle,fill=ink,inner sep=1.4pt},
note/.style={font=\footnotesize,align=center,text=black!75}]

\node[sum](e)at(.9,1.5){$\Sigma$};
\node[block,minimum height=14mm](c)at(4,1.5){Digital controller\\$u_k=2e_k+I_k$\\$I_{k+1}=I_k+4T_se_k$};
\node[block](zoh)at(8,1.5){Zero-order\\hold};
\node[block](p)at(11.7,1.5){$\dfrac{1}{0.5s+1}$};
\draw[sig](-.2,1.5)--node[above]{$r_k$}node[pos=.9,below]{$+$}(e);
\draw[sig](e)--node[above]{$e_k$}(c);
\draw[sig](c)--node[above]{$u_k$}(zoh);
\draw[sig](zoh)--node[above]{$u(t)$}(p);
\draw[sig](p)--(14.7,1.5)node[right]{$y(t)$};
\node[block](sam)at(11.7,-.4){Sample at $kT_s$};
\draw[fb](14,1.5)--(14,-.4)--(sam);
\fill[ink](14,1.5)circle(1.4pt);
\draw[fb](sam)--node[above]{$y_k$}(.9,-.4)--node[pos=.9,left]{$-$}(e);
\draw[sig](2,-2.8)--(8,-2.8)node[right]{$t$};
\draw[line width=1pt,draw=ink](2,-2.1)--(3.2,-2.1)--(3.2,-1.5)--(4.4,-1.5)--(4.4,-2.3)--(5.6,-2.3)--(5.6,-1.8)--(6.8,-1.8);
\foreach \x in{2,3.2,4.4,5.6,6.8}{\draw[black!40,densely dashed](\x,-2.8)--(\x,-1.25);}
\node[note]at(11.2,-2.2){$u(t)=u_k$ on $[kT_s,(k+1)T_s)$\\The current $I_k$ is used before updating it.};

\end{tikzpicture}
