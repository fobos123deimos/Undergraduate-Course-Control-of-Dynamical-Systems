% Style 2: raster equipment illustration with exact editable TikZ annotations.
\definecolor{detailFlow}{RGB}{30,128,163}
\definecolor{detailHeat}{RGB}{185,98,34}
\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
lab/.style={align=center,font=\sffamily\small,fill=white,fill opacity=.94,text opacity=1,rounded corners=2pt,inner xsep=3pt,inner ysep=2.5pt},
lead/.style={draw=ink!70,line width=.7pt},
flow/.style={-{Latex[length=2.2mm,width=1.5mm]},draw=detailFlow,line width=1.05pt},
heat/.style={-{Latex[length=2.2mm,width=1.5mm]},draw=detailHeat,line width=1.05pt},
heatboth/.style={<->,draw=orange!85!black,line width=1.15pt},
measure/.style={->,draw=teal!70!black,line width=1.05pt},
digital/.style={-{Latex[length=2.2mm,width=1.5mm]},draw=teal!70!black,line width=.95pt,dashed,rounded corners=3pt},
beam/.style={->,draw=red!70!black,line width=.65pt},
dim/.style={{Latex[length=1.8mm,width=1.2mm]}-{Latex[length=1.8mm,width=1.2mm]},draw=ink!70,line width=.7pt},
wire/.style={draw=ink,line width=1pt}]
\IfFileExists{figures/11-digital-control-art.png}{\def\equipmentart{figures/11-digital-control-art.png}}{\IfFileExists{../../laboratories/11-digital-control/figures/11-digital-control-art.png}{\def\equipmentart{../../laboratories/11-digital-control/figures/11-digital-control-art.png}}{\IfFileExists{../laboratories/11-digital-control/figures/11-digital-control-art.png}{\def\equipmentart{../laboratories/11-digital-control/figures/11-digital-control-art.png}}{\def\equipmentart{laboratories/11-digital-control/figures/11-digital-control-art.png}}}}
\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=9cm]{\equipmentart}};
\node[anchor=west,text=ink,font=\sffamily\bfseries\large] at (.2,9.38) {Sampled control of an RC process};
% Leaders start outside the labels and terminate on the intended hardware.
\node[lab,text=ink] (dacLabel) at (2.5,7.35) {DAC\\zero-order hold};
\draw[lead,shorten <=3pt] (dacLabel.south)--(2.5,5.82);
\fill[ink!70] (2.5,5.82) circle (.028);
\node[lab,text=ink] (adcLabel) at (13.6,7.35) {ADC\\sample $y_k$};
\draw[lead,shorten <=3pt] (adcLabel.south)--(13.6,5.82);
\fill[ink!70] (13.6,5.82) circle (.028);
\node[lab,text=ink] (resistorLabel) at (6.9,6.65) {$R=10$ k$\Omega$};
\draw[lead,shorten <=3pt] (resistorLabel.south)--(6.9,4.55);
\fill[ink!70] (6.9,4.55) circle (.028);
\node[lab,text=ink] (capacitorLabel) at (6.9,3.2) {$C=50\,\mu$F};
\draw[lead,shorten <=3pt] (capacitorLabel.east)--(9.5,3.6);
\fill[ink!70] (9.5,3.6) circle (.028);
\draw[wire] (4.43,4.72)--(5,4.72)--(5,4.55)--(5.4,4.55) (8.6,4.55)--(8.9,4.55)--(8.9,5)--(9.96,5)--(11.2,5)--(11.2,4.55)--(11.7,4.55) (9.96,2.3)--(9.96,1.7)--(4.43,1.7)--(4.43,4.12);
\fill[ink] (9.96,5)circle(.055);
% Explicit common reference for DAC, capacitor and ADC measurement.
\draw[wire] (9.96,1.7)--(11.5,1.7)--(11.5,3.95)--(11.7,3.95);

\node[lab,text=ink] (commonLabel) at (12.5,2.55) {COM};
\draw[lead,shorten <=3pt] (commonLabel.west)--(11.5,2.55);
\fill[ink] (11.5,2.55) circle (.028);
\draw[wire] (9.96,1.7)--++(0,-.23)++(-.28,0)--++(.56,0)++(-.46,-.1)--++(.36,0)++(-.27,-.1)--++(.18,0);
\node[lab,text=ink] at (5.3,5.65) {$u(t)$};
\node[lab,text=ink] at (10.1,5.9) {$y(t)$};
% The dashed route is data/control, not an electrical return or a clock wire.
\node[lab,draw=teal!60!black,line width=.75pt,text=ink,minimum height=.65cm] (computer) at (8,.55) {Digital controller; period $T_s$};
\draw[digital,shorten >=2pt] (15.35,4.0)--(15.7,4.0)--(15.7,.55)--(computer.east);
\fill[teal!70!black] (15.35,4.0) circle (.028);
\draw[digital,shorten <=2pt,shorten >=1pt] (computer.west)--(.35,.55)--(.35,4.0)--(.72,4.0);
\node[lab,text=ink] at (2.3,1.1) {$u_k$};
\node[lab,text=ink] at (14.5,1.0) {$y_k$};

\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(0.2,-.3){\textbf{Continuous energy store}\\[3pt]$RC=0.5$ s; $\dot y=2(u-y)$.\\The held voltage drives a real-valued continuous state between samples.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(5.55,-.3){\textbf{Clocked interface}\\[3pt]$y_k=y(kT_s)$.\\$u(t)=u_k$ for $kT_s\leq t<(k+1)T_s$.\\Clock and update order matter.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(10.9,-.3){\textbf{Ideal converter boundary}\\[3pt]No quantization, electrical loading or converter dynamics. Use exact held-input discretization when comparing sample periods.};
\end{tikzpicture}
