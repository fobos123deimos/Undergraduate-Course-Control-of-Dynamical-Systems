\begin{tikzpicture}[x=1cm,y=1cm,>=Latex,font=\small,
block/.style={draw=ink,fill=blue!4,rounded corners=2pt,minimum height=9mm,align=center,line width=.7pt,inner sep=5pt},
sum/.style={circle,draw=ink,fill=white,minimum size=6mm,inner sep=0pt,line width=.7pt},
sig/.style={->,draw=ink,line width=.85pt},
fb/.style={->,draw=teal!70!black,line width=.85pt},
dist/.style={->,draw=orange!75!black,line width=.85pt},
tap/.style={circle,fill=ink,inner sep=1.4pt},
note/.style={font=\footnotesize,align=center,text=black!75}]

\node[draw=ink,fill=blue!6,minimum width=34mm,minimum height=10mm](m)at(2,2.2){Platform $m=8$ kg};
\draw[line width=1.2pt,draw=ink](-.3,-.1)--(4.3,-.1);
\draw[decorate,decoration={zigzag,segment length=2mm,amplitude=1.4mm},line width=.8pt](1,-.1)--(1,1.7);
\node[left]at(.8,.8){$k$};
\draw[line width=.8pt](3,-.1)--(3,.65);
\draw[line width=.8pt](2.65,1.2)--(2.65,.65)--(3.35,.65)--(3.35,1.2);
\draw[line width=.8pt](2.72,.9)--(3.28,.9);
\draw[line width=.8pt](3,.9)--(3,1.7);
\node[right]at(3.5,.8){$b$};
\draw[sig](4.5,1.6)--(4.5,2.8)node[above]{$x(t)$};
\draw[sig](4.5,-.5)--(4.5,.5)node[above]{$z(t)$};
\node[note]at(2,-.8){Moving floor\\coordinates about loaded equilibrium};
\node[block](g)at(9,2){$\dfrac{bs+k}{ms^2+bs+k}$};
\node[tap](zt)at(6,2){};
\node[tap](xt)at(12,2){};
\draw[sig](5.3,2)--node[above]{$z$}(g);
\draw[sig](g)--node[above]{$x$}(14,2);
\node[sum](rel)at(12,-.1){$\Sigma$};
\draw[sig](xt)--node[right]{$+$}(rel);
\draw[fb](zt)--(6,-.1)--node[pos=.9,below]{$-$}(rel);
\draw[sig](rel)--(14.2,-.1)node[right]{$x-z$};
\node[note]at(9,-1.5){$\omega_n=\sqrt{k/m}$,\quad $\zeta=\dfrac{b}{2\sqrt{mk}}$\\absolute motion and relative travel are different outputs};

\end{tikzpicture}
