\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
wall/.style={draw=ink,line width=1.2pt,fill=blue!5},
water/.style={fill=cyan!25,draw=none},
metal/.style={draw=ink,fill=blue!12,line width=.9pt},
flow/.style={->,draw=blue!65!black,line width=1.2pt},
heat/.style={->,draw=orange!85!black,line width=1.1pt},
measure/.style={->,draw=teal!70!black,line width=.9pt},
dim/.style={<->,draw=ink!65,line width=.6pt},
spring/.style={draw=ink,decorate,decoration={coil,aspect=.5,segment length=4pt,amplitude=3pt}},
wire/.style={draw=ink,line width=1pt},
lab/.style={align=center,font=\sffamily\small},
smalllab/.style={align=center,font=\sffamily\scriptsize}]

\draw[metal,rounded corners=3pt](.3,1.1)rectangle(3.1,4);
\draw[fill=white,draw=ink](.7,2.3)rectangle(2.7,3.5);
\draw[blue!70!black,domain=.8:2.6,samples=60]plot(\x,{2.9+.35*sin(360*(\x-.8)/1.8)});
\draw[ink](1,1.6)circle(.18)(2.3,1.6)circle(.18);
\node[lab]at(1.7,4.5){Signal source $u$};
\draw[wire](3.1,3.2)--(4,3.2);
\draw[metal](4,3)rectangle(5.3,3.4);
\node[lab]at(4.65,3.85){$R=10\,\Omega$};
\draw[wire](5.3,3.2)--(6,3.2);
\draw[spring](6,3.2)--(8,3.2);
\draw[wire](8,3.2)--(8.6,3.2);
\draw[wire](8.6,2.8)--(8.6,3.6)(8.85,2.8)--(8.85,3.6);
\draw[wire](8.85,3.2)--(9.5,3.2)--(9.5,.8)--(3.1,.8)--(3.1,1.6);
\node[lab]at(7,3.9){$L=10$ mH};
\node[lab]at(8.75,4.5){$C=100\,\mu$F};
\draw[flow](5.5,2.3)--(7,2.3)node[midway,below]{$i(t)$};
\draw[metal,rounded corners=3pt](10.7,1.7)rectangle(13.5,4);
\draw[fill=white,draw=ink](11,2.3)rectangle(13.2,3.7);
\draw[teal!70!black](11.15,2.55)--(11.5,3.4)--(11.85,2.6)--(12.2,3.3)--(12.55,2.7)--(13,3.1);
\node[smalllab]at(12.1,1.95){voltage readout};
\fill[ink](5.7,3.2)circle(.055)(9.5,3.2)circle(.055);
\draw[measure](5.7,3.2)--(5.7,5.1)--(12,5.1)--(12,4);
\draw[teal!70!black](9.5,3.2)--(10.2,3.2)--(10.2,1.35)--(12.8,1.35)--(12.8,1.7);
\node[smalllab]at(8.8,5.45){Differential probe across $L+C$: $y=u-Ri$};
\node[lab]at(6.8,-.05){Ideal series network; the output port includes direct feedthrough};
% REFINED EQUIPMENT DETAILS

% Instrument connectors and polarity of the ideal differential measurement.
\foreach \x/\y in {3.1/3.2,3.1/1.6}{\draw[ink,fill=white](\x,\y)circle(.085);}
\node[smalllab]at(4.65,2.65){R1};\node[smalllab]at(7,2.65){L1};\node[smalllab]at(8.75,2.45){C1};
\foreach \x in {11.4,11.8,12.2,12.6}{\draw[ink!15](\x,2.35)--(\x,3.65);}
\foreach \y in {2.65,2.95,3.25,3.55}{\draw[ink!15](11.05,\y)--(13.15,\y);}
\node[smalllab]at(12.25,4.15){$+$};\node[smalllab]at(13.05,1.6){$-$};
\draw[ink!40](9.5,.8)--(9.5,.5)(9.15,.5)--(9.85,.5)(9.25,.37)--(9.75,.37)(9.35,.24)--(9.65,.24);

\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.15cm,minimum height=1.65cm,inner sep=5pt,align=left,font=\sffamily\scriptsize]at(0.0,-0.75){\textbf{Electrical states}\\[3pt]Current $i$ [A] and capacitor voltage $v_C$ [V] store magnetic and electric energy.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.15cm,minimum height=1.65cm,inner sep=5pt,align=left,font=\sffamily\scriptsize]at(4.8,-0.75){\textbf{Circuit equations}\\[3pt]$L\dot i=u-Ri-v_C$.\\$C\dot v_C=i$.\\Output: $y=u-Ri=v_L+v_C$.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.15cm,minimum height=1.65cm,inner sep=5pt,align=left,font=\sffamily\scriptsize]at(9.6,-0.75){\textbf{Measurement boundary}\\[3pt]The two probe leads span $L+C$. The depicted instrument display is illustrative, not a measured response.};
\end{tikzpicture}
