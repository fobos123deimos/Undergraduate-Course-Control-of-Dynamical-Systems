% Style 2: raster equipment illustration with exact editable TikZ annotations.
\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
lab/.style={align=center,font=\sffamily\small,fill=white,fill opacity=.94,text opacity=1,rounded corners=2pt,inner sep=3.5pt},
lead/.style={draw=ink!70,line width=.7pt},
flow/.style={->,draw=blue!65!black,line width=1.15pt},
heat/.style={->,draw=orange!85!black,line width=1.15pt},
heatboth/.style={<->,draw=orange!85!black,line width=1.15pt},
measure/.style={->,draw=teal!70!black,line width=1.05pt},
digital/.style={->,draw=teal!70!black,line width=1pt,dashed},
beam/.style={->,draw=red!70!black,line width=.65pt},
dim/.style={<->,draw=ink!70,line width=.7pt},
wire/.style={draw=ink,line width=1pt}]
\IfFileExists{figures/04-notch-filter-art.png}{\def\equipmentart{figures/04-notch-filter-art.png}}{\IfFileExists{../../laboratories/04-notch-filter/figures/04-notch-filter-art.png}{\def\equipmentart{../../laboratories/04-notch-filter/figures/04-notch-filter-art.png}}{\IfFileExists{../laboratories/04-notch-filter/figures/04-notch-filter-art.png}{\def\equipmentart{../laboratories/04-notch-filter/figures/04-notch-filter-art.png}}{\def\equipmentart{laboratories/04-notch-filter/figures/04-notch-filter-art.png}}}}
\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=9cm]{\equipmentart}};
\node[anchor=west,text=ink,font=\sffamily\bfseries\large] at (.2,9.38) {Series RLC notch-filter experiment};
\node[lab,text=ink,text width=3.3cm] at (1.8,6.5) {Signal source $u$};
\node[lab,text=ink,text width=2.5cm] at (5.4,5.8) {$R=10\,\Omega$};
\node[lab,text=ink,text width=2.5cm] at (8.2,5.8) {$L=10$ mH};
\node[lab,text=ink,text width=2.7cm] at (10.7,6.15) {$C=100\,\mu$F};
\node[lab,text=ink,text width=3.3cm] at (13.8,2.05) {Voltage readout $y$};
\draw[wire] (3.5,4.85)--(3.9,4.85)--(3.9,4.4)--(4.35,4.4) (6.45,4.4)--(7.05,4.4) (9.3,4.4)--(10.05,4.4) (11.45,4.4)--(11.6,4.4)--(11.6,2.3)--(3.5,2.3)--(3.5,4.05);
\draw[measure] (6.75,4.4)--(6.75,7.1)--(12.43,7.1)--(12.43,4.83);
\draw[teal!70!black,line width=.9pt] (11.45,4.4)--(11.9,4.4)--(11.9,4.05)--(12.43,4.05);
\fill[ink] (6.75,4.4)circle(.055)(11.45,4.4)circle(.055);
\node[lab,text=ink,text width=9cm] at (8.9,7.9) {Differential probe across $L+C$: $y=u-Ri$};
\node[lab,text=teal!70!black,text width=0.5cm] at (12.8,5.3) {$+$};
\node[lab,text=teal!70!black,text width=0.5cm] at (12.75,3.9) {$-$};
\draw[flow] (6.1,3.2)--(7.8,3.2);
\node[lab,text=ink,text width=1.5cm] at (7,2.8) {$i(t)$};
\draw[wire] (11.6,2.3)--++(0,-.23)++(-.28,0)--++(.56,0)++(-.46,-.1)--++(.36,0)++(-.27,-.1)--++(.18,0);
\draw[cyan!55,line width=.8pt,domain=1.2:2.95,samples=50] plot(\x,{4.65+.2*sin(360*(\x-1.2)/1.75)});
\node[lab,text=ink,text width=12cm] at (8,0.55) {Ideal series network; output includes direct feedthrough};

\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(0.2,-.3){\textbf{Electrical states}\\[3pt]Current $i$ [A] and capacitor voltage $v_C$ [V] store magnetic and electric energy.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(5.55,-.3){\textbf{Circuit equations}\\[3pt]$L\dot i=u-Ri-v_C$.\\$C\dot v_C=i$.\\Output: $y=u-Ri=v_L+v_C$.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(10.9,-.3){\textbf{Measurement boundary}\\[3pt]The two probe leads span $L+C$. The depicted instrument display is illustrative, not a measured response.};
\end{tikzpicture}
