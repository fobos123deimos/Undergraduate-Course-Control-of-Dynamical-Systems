\begin{tikzpicture}[x=1cm,y=1cm,>=Latex,font=\small,
block/.style={draw=ink,fill=blue!4,rounded corners=2pt,minimum height=9mm,align=center,line width=.7pt,inner sep=5pt},
sum/.style={circle,draw=ink,fill=white,minimum size=6mm,inner sep=0pt,line width=.7pt},
sig/.style={->,draw=ink,line width=.85pt},
fb/.style={->,draw=teal!70!black,line width=.85pt},
dist/.style={->,draw=orange!75!black,line width=.85pt},
tap/.style={circle,fill=ink,inner sep=1.4pt},
note/.style={font=\footnotesize,align=center,text=black!75}]

\draw[draw=ink,line width=.85pt](.5,.3)--(.5,1.05);
\draw[draw=ink,line width=.85pt](.5,1.45)circle(.4);
\node at(.5,1.45){$\sim$};
\draw[draw=ink,line width=.85pt](.5,1.85)--(.5,3)--(2,3);
\node[left]at(.05,1.45){$u(t)$};
\draw[draw=ink,fill=blue!4,line width=.85pt](2,2.75)rectangle(3.4,3.25);
\node[above]at(2.7,3.3){$R=10\ \Omega$};
\draw[draw=ink,line width=.85pt](3.4,3)--(5,3);
\draw[decorate,decoration={coil,aspect=.55,segment length=2.5mm,amplitude=2mm},line width=.85pt,draw=ink](5,3)--(7,3);
\node[above]at(6,3.3){$L=0.01\ \mathrm{H}$};
\draw[draw=ink,line width=.85pt](7,3)--(9,3)--(9,1.9);
\draw[line width=.85pt,draw=ink](8.5,1.9)--(9.5,1.9)(8.5,1.65)--(9.5,1.65);
\draw[line width=.85pt,draw=ink](9,1.65)--(9,.3)--(.5,.3);
\node[right]at(9.6,1.8){$C=100\ \mu\mathrm{F}$};
\draw[sig](3.7,3.8)--node[above]{$i(t)$}(4.8,3.8);
\node[tap](a)at(4.1,3){};\node[tap](b)at(4.1,.3){};
\draw[fb](a)--node[right]{$y=v_L+v_C$}(b);
\node at(3.8,2.7){$+$};\node at(3.8,.6){$-$};
\node[note]at(13,3){Ideal unloaded\\voltage measurement};
\node[block](h)at(8,-1.6){$H(s)=\dfrac{LCs^2+1}{LCs^2+RCs+1}$};
\draw[sig](2,-1.6)--node[above]{$U(s)$}(h);
\draw[sig](h)--(14,-1.6)node[right]{$Y(s)$};
\node[note]at(8,-2.8){At $\omega_0=1/\sqrt{LC}$, reactive voltages cancel; current and stored energy need not vanish.};

\end{tikzpicture}
