\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
wall/.style={draw=ink,line width=1.2pt,fill=blue!5},
water/.style={fill=cyan!25,draw=none},
metal/.style={draw=ink,fill=blue!12,line width=.9pt},
flow/.style={->,draw=blue!65!black,line width=1.2pt},
heat/.style={->,draw=orange!85!black,line width=1.1pt},
measure/.style={->,draw=teal!70!black,line width=.9pt},
dim/.style={<->,draw=ink!65,line width=.6pt},
spring/.style={draw=ink,decorate,decoration={coil,aspect=.5,segment length=4pt,amplitude=3pt}},
wire/.style={draw=ink,line width=1pt},
lab/.style={align=center,font=\sffamily\small},
smalllab/.style={align=center,font=\sffamily\scriptsize}]

\draw[wall](.3,.2)--(.3,4.1)--(6.2,4.1)--(6.2,.2)--cycle;
\fill[cyan!7](.5,.4)rectangle(6,3.9);
\draw[metal](.9,2.5)circle(.48);
\foreach \a in {0,120,240}{\draw[ink,fill=blue!20,rotate around={\a:(.9,2.5)}](.9,2.5)..controls(.6,3.1)and(1.3,3.2)..(1.15,2.65)--cycle;}
\draw[flow](-.4,2.5)--(.35,2.5);
\draw[flow](1.5,2.5)--(2.5,2.5);
\draw[flow](5.5,2.5)--(6.8,2.5);
\node[smalllab]at(1.2,3.65){clean air $q$};
\node[smalllab]at(5.15,3.65){exhaust $q\,c$};
\draw[metal](2.4,.6)rectangle(3.6,1.2);
\foreach \x in {2.6,3,3.4}{\draw[heat](\x,1.3)..controls(\x-.2,1.6)and(\x+.2,1.8)..(\x,2);}
\node[smalllab]at(3,2.35){source $S$};
\node[lab]at(3.2,4.65){Ventilated room};
\node[lab]at(3.2,-.4){$V=120$ m$^3$; concentration $c$};
\fill[water](8,.4)rectangle(12.6,2.9);
\draw[wall,fill=none](8,4)--(8,.4)--(12.6,.4)--(12.6,4);
\draw[blue!60](8,2.9)--(12.6,2.9);
\draw[flow](7.4,4.3)--(8.6,4.3)--(8.6,3.3);
\draw[flow](12.6,1)--(13.5,1);
\draw[metal](9.8,3.6)rectangle(10.8,4.1);
\draw[wire](10.3,3.6)--(10.3,1.2);
\draw[wire](9.6,1.3)--(11,1.3)(9.6,1.3)--(9.4,1.6)(11,1.3)--(11.2,1);
\draw[heat](11.8,4.3)--(11.8,3.3);
\node[smalllab]at(11.9,4.65){dose $S$};
\node[smalllab]at(8.4,4.7){clean $q$};
\node[smalllab,anchor=west]at(12.8,1.6){$q\,c$};
\node[lab]at(10.3,2.25){well mixed\\$V=120$ L};
\node[lab]at(10.3,-.4){Liquid analogue: same balance, different units};
\end{tikzpicture}
