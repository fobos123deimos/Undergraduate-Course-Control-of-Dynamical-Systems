% Style 2: raster equipment illustration with exact editable TikZ annotations.
\begin{tikzpicture}[
font=\sffamily\small,>=Latex,line cap=round,line join=round,
lab/.style={align=center,font=\sffamily\small,fill=white,fill opacity=.94,text opacity=1,rounded corners=2pt,inner sep=3.5pt},
lead/.style={draw=ink!70,line width=.7pt},
flow/.style={->,draw=blue!65!black,line width=1.15pt},
heat/.style={->,draw=orange!85!black,line width=1.15pt},
heatboth/.style={<->,draw=orange!85!black,line width=1.15pt},
measure/.style={->,draw=teal!70!black,line width=1.05pt},
digital/.style={->,draw=teal!70!black,line width=1pt,dashed},
beam/.style={->,draw=red!70!black,line width=.65pt},
dim/.style={<->,draw=ink!70,line width=.7pt},
wire/.style={draw=ink,line width=1pt}]
\IfFileExists{figures/02-ventilation-art.png}{\def\equipmentart{figures/02-ventilation-art.png}}{\IfFileExists{../../laboratories/02-ventilation/figures/02-ventilation-art.png}{\def\equipmentart{../../laboratories/02-ventilation/figures/02-ventilation-art.png}}{\IfFileExists{../laboratories/02-ventilation/figures/02-ventilation-art.png}{\def\equipmentart{../laboratories/02-ventilation/figures/02-ventilation-art.png}}{\def\equipmentart{laboratories/02-ventilation/figures/02-ventilation-art.png}}}}
\node[anchor=south west,inner sep=0] at (0,0) {\includegraphics[width=16cm,height=9cm]{\equipmentart}};
\node[anchor=west,text=ink,font=\sffamily\bfseries\large] at (.2,9.38) {Ventilation and its liquid analogue};
\node[lab,text=ink,text width=4cm] at (4.1,8.35) {Ventilated room};
\node[lab,text=ink,text width=3.2cm] at (12.0,8.35) {Mixed tank};
\draw[flow] (0.2,4.4)--(1.5,4.4);
\draw[lead] (1.65,7.1)--(1.65,5.55);
\node[lab,text=ink,text width=2.6cm] at (1.65,7.45) {Clean air $q$};
\draw[flow] (7.8,4.4)--(9.0,4.4);
\draw[lead] (7.4,7.1)--(7.8,5.15);
\node[lab,text=ink,text width=2.1cm] at (7.4,7.45) {Exhaust $qc$};
\draw[lead,draw=orange!85!black] (4.15,4.65)--(4.2,2.7);
\fill[orange!85!black] (4.2,2.7) circle (.035);
\node[lab,text=orange!85!black,text width=2.8cm] at (4.15,4.65) {Tracer source $S$};
\draw[lead,draw=teal!70!black] (6.5,1.4)--(6.5,2.8);
\fill[teal!70!black] (6.5,2.8) circle (.035);
\node[lab,text=teal!70!black,text width=2.0cm] at (6.5,1.4) {Sensor $c$};
\draw[flow] (9.5,6.8)--(10.35,6.8);
\node[lab,text=ink,text width=1.8cm] at (9.9,7.45) {Clean $q$};
\draw[heat] (14.35,6.9)--(13.55,6.9);
\node[lab,text=ink,text width=2.2cm] at (14.35,7.45) {Dose $S$};
\draw[flow] (14.7,2.6)--(15.7,2.6);
\node[lab,text=ink,text width=1.3cm] at (15.0,3.2) {$qc$};
\node[lab,text=ink,text width=7cm] at (4.2,0.55) {$V=120$ m$^3$; concentration $c$};
\node[lab,text=ink,text width=7cm] at (12.0,0.55) {$V=120$ L; same balance, different units};

\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(0.2,-.3){\textbf{Inventory and channels}\\[3pt]$c$: tracer concentration.\\$S$: source rate; $q$: throughput.\\Equal inlet/outlet flow fixes $V$.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(5.55,-.3){\textbf{Balance and bilinearity}\\[3pt]$V\dot c=S-qc$.\\The product $qc$ couples state and input. Room and liquid cases use different volume units.};
\node[draw=ink!25,fill=blue!2,rounded corners=2pt,anchor=north west,text width=4.55cm,minimum height=1.9cm,inner sep=5pt,align=left,font=\sffamily\footnotesize]at(10.9,-.3){\textbf{Mixing assumption}\\[3pt]The fan and stirrer illustrate ideal mixing only. Air velocity fields, fan dynamics and mixing transients are not modeled.};
\end{tikzpicture}
