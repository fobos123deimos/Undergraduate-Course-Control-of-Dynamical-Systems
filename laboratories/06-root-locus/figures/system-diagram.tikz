\begin{tikzpicture}[x=1cm,y=1cm,>=Latex,font=\small,
block/.style={draw=ink,fill=blue!4,rounded corners=2pt,minimum height=9mm,align=center,line width=.7pt,inner sep=5pt},
sum/.style={circle,draw=ink,fill=white,minimum size=6mm,inner sep=0pt,line width=.7pt},
sig/.style={->,draw=ink,line width=.85pt},
fb/.style={->,draw=teal!70!black,line width=.85pt},
dist/.style={->,draw=orange!75!black,line width=.85pt},
tap/.style={circle,fill=ink,inner sep=1.4pt},
note/.style={font=\footnotesize,align=center,text=black!75}]

\node[sum](e)at(1,1.8){$\Sigma$};
\node[block](k)at(4,1.8){Controller $K$};
\node[block](p)at(9,1.8){$\dfrac{1}{s(s+2)(s+6)}$};
\draw[sig](-.2,1.8)--node[above]{$r$}node[pos=.9,below]{$+$}(e);
\draw[sig](e)--node[above]{$e$}(k);
\draw[sig](k)--node[above]{$u$}(p);
\draw[sig](p)--(14,1.8)node[right]{$y$};
\draw[fb](13.5,1.8)--(13.5,.3)--(1,.3)--node[pos=.9,left]{$-$}(e);
\fill[ink](13.5,1.8)circle(1.4pt);
\begin{scope}[shift={(10,-2)},x=1.3cm,y=.75cm]
\draw[sig](-6.7,0)--(1.8,0)node[right]{$\operatorname{Re}s$};
\draw[sig](0,-.7)--(0,1.4)node[above]{$\operatorname{Im}s$};
\foreach \v in {-6,-2,0}{\draw[ink,line width=1.1pt](\v-.09,-.12)--(\v+.09,.12)(\v-.09,.12)--(\v+.09,-.12);\node[below=4mm]at(\v,0){$\v$};}
\end{scope}
\node[note]at(5,-3.1){$\times$ = open-loop pole; no finite zeros\\closed-loop roots satisfy $s(s+2)(s+6)+K=0$};

\end{tikzpicture}
