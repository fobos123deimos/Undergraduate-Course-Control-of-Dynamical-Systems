\draw[lead,draw=ink] (9.5,8.15)--(9.5,6.1);
\fill[ink] (9.5,6.1) circle (.035);
\node[lab,text=ink,text width=3.0cm] at (9.5,8.15) {Carriage / nut};
\draw[lead,draw=teal!70!black] (12.5,1.15)--(9.95,2.95);
